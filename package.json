{
  "name": "spotlight-todo",
  "version": "1.0.2",
  "description": "DeepDive file search and Todo desktop app with Apple Liquid Glass UI",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/run-electron-vite.cjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"electron/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:sync": "npm run build && electron scripts/test-sync-engine.cjs",
    "benchmark:sync": "electron scripts/benchmark-sync.cjs",
    "benchmark:sync:worker": "npm run build && electron scripts/benchmark-sync-worker.cjs",
    "runtime:sync": "npm run build && node scripts/launch-runtime-sync.cjs --profile=medium",
    "capture:design": "npm run build && node scripts/launch-design-capture.cjs",
    "package": "npm run release",
    "package:win": "npm run release",
    "release": "node scripts/package-release.cjs",
    "release:dry-run": "node scripts/package-release.cjs --dry-run",
    "release:local": "node scripts/package-release.cjs --local",
    "release:local:dry-run": "node scripts/package-release.cjs --local --dry-run",
    "verify:release:security": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-release-security.ps1",
    "release:split": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Create-SharePackage.ps1",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "framer-motion": "^11.1.7"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@electron/fuses": "2.1.3",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.1.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^8.57.0",
    "node": "22.12.0",
    "prettier": "^3.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.5",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "com.spotlight-todo.app",
    "productName": "DeepDive",
    "icon": "resources/icon.svg",
    "asar": true,
    "forceCodeSigning": true,
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "out",
      "resources"
    ],
    "extraResources": [
      {
        "from": "electron/main/db/migrations",
        "to": "migrations"
      },
      {
        "from": "resources/ai",
        "to": "ai"
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "DeepDive-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "DeepDive-${version}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepDive"
    }
  }
}
